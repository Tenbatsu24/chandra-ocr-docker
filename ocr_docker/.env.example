# Copy to .env and adjust as needed. docker-compose picks this up automatically.

# Model served by vLLM inside the container.
MODEL_CHECKPOINT=datalab-to/chandra-ocr-2
VLLM_MODEL_NAME=chandra

# Fraction of GPU memory vLLM is allowed to use (0-1). Lower this if you're
# sharing the GPU with other workloads.
GPU_MEMORY_UTILIZATION=0.75

# Optional: cap the model's context length (tokens) if you hit KV-cache OOM
# on a smaller/shared GPU. Leave unset to use the model's default.
# MAX_MODEL_LEN=8192

# How many `chandra` CLI jobs (i.e. HTTP requests) can run concurrently.
# Each job dispatches its own pages to vLLM, which queues/batches internally,
# so this mostly controls CPU-side concurrency (PDF rendering, zipping, etc.)
MAX_CONCURRENT_JOBS=2

# Hard timeout (seconds) for a single document's processing job.
JOB_TIMEOUT_SECONDS=1800

# Only needed if datalab-to/chandra-ocr-2 requires an authenticated
# HuggingFace download (gated repo).
HF_TOKEN=

# Extra raw args appended to `vllm serve ...`, space-separated, e.g.:
# VLLM_EXTRA_ARGS=--max-num-seqs 64 --enforce-eager
VLLM_EXTRA_ARGS=
