# Copy to .env and adjust as needed. Both scripts read these via python-dotenv.
# Any value missing from .env must be supplied on the command line.

# --- Zotero ---
# Path to the Zotero data directory (contains zotero.sqlite and storage/).
ZOTERO_DIR=

# JSON file listing which citation keys to process. Can be a list of strings,
# a list of dicts with an "id" field, or an object with a "citationKeys" list.
ZOTERO_SYNC_FILE=

# --- Output paths ---
# Base directory used only to derive defaults for other paths.
BASE_DIR=

# Notes directory (used to derive vault-dir, state-file, and sync-file defaults).
NOTES_DIR=

# Obsidian vault directory (used to derive raw-literature-dir default).
VAULT_DIR=

# Output directory for OCR results — one subfolder per citation key.
RAW_LITERATURE_DIR=

# Obsidian research notes output directory (for create_slugs.py).
OBSIDIAN_RESEARCH_DIR=

# JSON file tracking which citation keys have been OCR'd. If omitted,
# everything in --zotero-sync-file is (re)processed every run and no
# progress is persisted. Strongly recommended to set this.
STATE_FILE=

# --- OCR ---
# Base URL of the Chandra OCR server.
OCR_SERVER=http://127.0.0.1:8080

# Seconds to sleep between processing consecutive papers.
SLEEP_SECONDS=15
